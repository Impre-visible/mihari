<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mihari"
        Arguments=""
        InstallLocation="C:\Program Files\Mihari\Mihari">
    </Installer>
    <PackageInformation
        PackageName="Mihari"
        PackageDisplayName="Mihari"
        PublisherName="CN=Mihari"
        PublisherDisplayName="Mihari"
        Version="0.1.0.0"
        PackageDescription="Review de code et écriture de tests par LLM local">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.mihari.app"
                Description="Review de code et écriture de tests par LLM local"
                DisplayName="Mihari"
                ExecutableName="mihari"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Mihari</DisplayName>
            <PublisherDisplayName>Mihari</PublisherDisplayName>
            <Description>Review de code et écriture de tests par LLM local</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mihari.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
